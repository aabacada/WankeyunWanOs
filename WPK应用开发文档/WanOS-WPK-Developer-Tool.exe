    <script>
      (function() {
        var input = document.getElementById("homeWanOSIdInput");
        var button = document.getElementById("homeWanOSIdButton");
        var message = document.getElementById("homeWanOSIdMessage");
        if (!input || !button || !message) return;
        function setLoading(loading) {
          button.disabled = loading || !input.value.trim();
          button.textContent = loading ? "连接中" : "连接";
        }
        async function connect() {
          var id = input.value.trim();
          if (!id) {
            message.textContent = "请输入 WanOS ID。";
            setLoading(false);
            return;
          }
          setLoading(true);
          message.textContent = "正在查找设备...";
          try {
            var res = await fetch("/api/connect/resolve?id=" + encodeURIComponent(id), { cache: "no-store" });
            var data = await res.json().catch(function() { return {}; });
            if (!res.ok || !data.ok || !data.public_url) throw new Error(data.error || "没有找到已绑定设备。");
            message.textContent = "已找到设备，正在跳转...";
            location.href = data.public_url;
          } catch (err) {
            message.textContent = err && err.message ? err.message : "查找失败。";
            setLoading(false);
          }
        }
        input.addEventListener("input", function() {
          message.textContent = "";
          setLoading(false);
        });
        input.addEventListener("keydown", function(event) {
          if (event.key === "Enter") connect();
        });
        button.addEventListener("click", connect);
        setLoading(false);
      })();
    </script>
    <script>
      (function() {
        var modal = document.getElementById("homeLaunchModal");
        if (!modal) return;
        function show() { modal.classList.add("active"); modal.setAttribute("aria-hidden", "false"); }
        function hide() { modal.classList.remove("active"); modal.setAttribute("aria-hidden", "true"); }
        modal.querySelectorAll("[data-home-launch-close]").forEach(function(el) { el.addEventListener("click", hide); });
        document.addEventListener("keydown", function(event) { if (event.key === "Escape") hide(); });
        if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", show);
        else show();
      })();
    </script>
