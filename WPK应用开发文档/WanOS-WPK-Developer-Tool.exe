    <script>
      (function() {
        var modal = document.getElementById("installEnvModal");
        var open = document.getElementById("installEnvOpen");
        if (!modal || !open) return;
        function show() { modal.classList.add("active"); modal.setAttribute("aria-hidden", "false"); }
        function hide() { modal.classList.remove("active"); modal.setAttribute("aria-hidden", "true"); }
        open.addEventListener("click", show);
        modal.querySelectorAll("[data-install-env-close]").forEach(function(el) { el.addEventListener("click", hide); });
        document.addEventListener("keydown", function(event) { if (event.key === "Escape") hide(); });
      })();
    </script>
    <script>
      (function(){
        var entry=document.querySelector(".account-entry");
        if(!entry)return;
        try{
          var user=JSON.parse(localStorage.getItem("wanos_forum_user")||"null");
          if(!user||!(user.name||user.wanos_id))return;
          if(user.avatar){
            entry.innerHTML='<img src="'+String(user.avatar).replace(/"/g,"&quot;")+'" alt="" style="width:24px;height:24px;border-radius:50%;object-fit:cover">';
          }else{
            entry.textContent=String(user.name||user.wanos_id).slice(0,1).toUpperCase();
          }
          entry.title=user.name||user.wanos_id;
          entry.setAttribute("data-short","账号");
        }catch(e){}
      })();
    </script>
